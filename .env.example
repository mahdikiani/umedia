DOMAIN=drive.uln.me
PROJECT_NAME=umedia
# Optional. When omitted, a secure key is generated in the persistent data volume.
# UMEDIA_MASTER_KEY=

# Google OAuth — same Desktop / "Installed app" client is used for both:
# - Identity login (usso.lite OIDC: openid/email/profile) via /auth/oidc/*
# - Google Drive storage connect via /providers/oauth/* (Drive scopes)
# Do not merge those flows; scopes differ.
# Drive OAuth uses localhost paste flow (UMEDIA_GOOGLE_OAUTH_REDIRECT_URI).
# Identity login should use a server callback on your public domain:
# UMEDIA_OIDC_REDIRECT_URI=https://your.domain/api/v1/auth/oidc/callback
# Register that URI in Google Cloud Console alongside http://localhost.
# UMEDIA_GOOGLE_OAUTH_CLIENT_ID=
# UMEDIA_GOOGLE_OAUTH_CLIENT_SECRET=
# UMEDIA_GOOGLE_OAUTH_REDIRECT_URI=http://localhost
# Microsoft Entra app: redirect URI must include http://localhost.
# UMEDIA_ONEDRIVE_OAUTH_CLIENT_ID=
# UMEDIA_ONEDRIVE_OAUTH_CLIENT_SECRET=
# UMEDIA_ONEDRIVE_OAUTH_REDIRECT_URI=http://localhost
# Dropbox app: add http://localhost to the app's OAuth redirect URIs.
# UMEDIA_DROPBOX_OAUTH_CLIENT_ID=
# UMEDIA_DROPBOX_OAUTH_CLIENT_SECRET=
# UMEDIA_DROPBOX_OAUTH_REDIRECT_URI=http://localhost
# UMEDIA_OIDC_REDIRECT_URI=https://your.domain/api/v1/auth/oidc/callback
# Bare GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET are also accepted.

# Sentry (optional). Media: fastapi_mongo_base setup_sentry via SENTRY_DSN.
# Web: baked into the Next.js client at build time as NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=preview
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Inbound Storage→library poll interval in seconds (default 15 minutes).
# Manual POST /providers/{uid}/sync always runs immediately.
# UMEDIA_SYNC_POLL_INTERVAL_SECONDS=900
# NEXT_PUBLIC_SENTRY_DSN=
