{
  "id": "telegram",
  "name": "Telegram",
  "description": "Store media in a Telegram channel using MTProto.",
  "entrypoint": ["python", "-m", "plugins.telegram.main"],
  "status": "beta",
  "connect_flow": "session",
  "capabilities": ["list", "read", "write", "delete", "copy"],
  "config_fields": [
    { "key": "api_id", "label": "API ID" },
    { "key": "api_hash", "label": "API hash", "secret": true },
    { "key": "channel_id", "label": "Channel ID" },
    {
      "key": "session",
      "label": "Session",
      "input_type": "password",
      "secret": true
    }
  ]
}
