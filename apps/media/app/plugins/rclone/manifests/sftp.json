{
  "id": "sftp",
  "name": "SFTP",
  "description": "Files over SSH. Sign in with a password or a private key.",
  "entrypoint": ["python", "-m", "plugins.rclone.main"],
  "process_id": "rclone",
  "remote_type": "sftp",
  "status": "beta",
  "capabilities": ["list", "read", "write", "delete", "move", "copy"],
  "config_fields": [
    { "key": "host", "label": "Host", "placeholder": "sftp.example.com" },
    { "key": "port", "label": "Port", "required": false, "placeholder": "22" },
    { "key": "user", "label": "Username" },
    { "key": "password", "label": "Password", "input_type": "password", "secret": true, "required": false },
    { "key": "private_key", "label": "Private key (PEM)", "input_type": "password", "secret": true, "required": false, "placeholder": "-----BEGIN OPENSSH PRIVATE KEY----- ..." },
    { "key": "key_passphrase", "label": "Key passphrase", "input_type": "password", "secret": true, "required": false },
    { "key": "host_key", "label": "Server host key", "required": false, "hidden": true },
    { "key": "root_path", "label": "Base folder", "required": false, "placeholder": "Home folder" }
  ]
}
