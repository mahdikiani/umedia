# Image tag published by the matching GitHub release.
UMEDIA_VERSION=v0.1.1

# Replace this with a private, stable key before storing real data.
# Generate one with: openssl rand -hex 32
UMEDIA_MASTER_KEY=replace-with-a-random-64-character-hex-key

# Optional OAuth credentials. See the self-hosting guide before enabling.
UMEDIA_GOOGLE_OAUTH_CLIENT_ID=
UMEDIA_GOOGLE_OAUTH_CLIENT_SECRET=
UMEDIA_ONEDRIVE_OAUTH_CLIENT_ID=
UMEDIA_ONEDRIVE_OAUTH_CLIENT_SECRET=
UMEDIA_DROPBOX_OAUTH_CLIENT_ID=
UMEDIA_DROPBOX_OAUTH_CLIENT_SECRET=
